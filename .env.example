# ─────────────────────────────────────────
# TMDB API
# Get your key at: https://www.themoviedb.org/settings/api
# ─────────────────────────────────────────
VITE_TMDB_API_KEY=

# ─────────────────────────────────────────
# Upstash Redis (Persistent Snapshot Cloud Store - Free Tier)
# Get these at: https://console.upstash.com (Create free Redis database)
# Never pauses or freezes.
# ─────────────────────────────────────────
VITE_UPSTASH_REDIS_REST_URL=
VITE_UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────
# Google OAuth 2.0 Client ID (Optional for Sign-in with Google)
# Get from: https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=

